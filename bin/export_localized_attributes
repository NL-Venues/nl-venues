#!/usr/bin/env bash
# Regenerates docs/development/localized_attributes.mmd, the diagram of this app's own localized
# (Mobility) attributes. Run it after adding, removing or retyping any `translates` attribute.
#
#   bin/export_localized_attributes            # regenerate
#   bin/export_localized_attributes --check    # write nothing; fail if stale or any translates is untyped
set -euo pipefail

cd "$(dirname "$0")/.."

exec bin/dc-run bin/rails runner scripts/export_localized_attributes.rb "$@"
